#!/usr/bin/env bash
# Launcher for the Tucunar cell console.
#
# Desktop sessions start programs without the shell environment, so this script
# resolves the checkout from its own location.
set -euo pipefail

here="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
root="$(cd -- "$here/.." && pwd)"
binary="$root/target/release/tucunar-cell-console"

if [ ! -x "$binary" ]; then
  notify-send --app-name "Tucunar Water Grid" "Console not built" \
    "Run: cd $root && cargo build --release" 2>/dev/null || true
  echo "tucunar-cell-console is not built; run: cd $root && cargo build --release" >&2
  exit 1
fi

# Desktop sessions do not inherit token exports from an interactive shell.
# Reuse the private token generated by the standard Community initializer.
if [[ -z "${TUCUNAR_CONSOLE_TOKEN_FILE:-}" && -z "${CANARY_NODE_API_TOKEN:-}" \
    && -f "$HOME/.local/share/tucunar-cell/operator.token" ]]; then
  export TUCUNAR_CONSOLE_TOKEN_FILE="$HOME/.local/share/tucunar-cell/operator.token"
fi

# The Cell API is reached through a port-forward; start it on demand.
if [[ "${TUCUNAR_CELL_ADDR:-127.0.0.1:18080}" == "127.0.0.1:18080" ]] \
    && ! (exec 3<>/dev/tcp/127.0.0.1/18080) 2>/dev/null; then
  kubeconfig="${KUBECONFIG:-$HOME/.kube/config}"
  if [ -r "$kubeconfig" ] && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user is-enabled --quiet tucunar-cell-api-forward 2>/dev/null; then
    systemctl --user start tucunar-cell-api-forward 2>/dev/null || true
  fi
else
  exec 3>&-
fi

cd "$root"
exec "$binary" "$@"
