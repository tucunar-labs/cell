{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tucunar.com/contracts/scada-topology/1.0.0",
  "title": "Local SCADA topology snapshot",
  "description": "Read-only observed topology from a simulator or adapter. Measurements remain in the cell signal API. Writers atomically replace the local snapshot with owner-only permissions; readers must check observed_at.",
  "type": "object",
  "required": [
    "version",
    "source",
    "observed_at",
    "nodes",
    "links"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Optional equipment or logical role; junction has no measurement."
          },
          "metric": {
            "type": "string",
            "description": "Primary signal name on this node entity."
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "metric_entity": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "systems": {
      "type": "object",
      "description": "Optional observed equipment inventories keyed by tag area. Empty links mean connectivity is not supplied, not inferred.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "nodes",
          "links"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "description": "Optional equipment or logical role; junction has no measurement."
                },
                "metric": {
                  "type": "string",
                  "description": "Primary signal name on this node entity."
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "from",
                "to"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "metric_entity": {
                  "type": "string"
                },
                "metric": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              }
            }
          },
          "provenance": {
            "type": "string",
            "description": "simulator-model identifies adapter relationships from simulator equations, not observed physical wiring."
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
